# ================================================================
# Plantilla de variables de entorno — este archivo SÍ se sube al
# repositorio. Contiene las claves necesarias pero SIN valores reales.
#
# Local:      cp .env.example .env   y rellena los valores.
# Render:     NO se usa .env. Crea las mismas claves en
#             Dashboard -> tu servicio -> Environment.
#             Las variables del servidor tienen prioridad sobre .env.
# ================================================================

# ----------------------------------------------------------------
# Base de datos
#   DB_DRIVER   mysql  -> MySQL / MariaDB (local)
#               pgsql  -> PostgreSQL (Supabase)
#   DB_SSLMODE  vacío en local; "require" para Supabase
#   DB_CHARSET  solo aplica a mysql
#
# Ejemplo local (MySQL/MariaDB con database/01 y 02):
#   DB_DRIVER=mysql  DB_HOST=127.0.0.1  DB_PORT=3306
#   DB_DATABASE=crud_usuarios  DB_USERNAME=Estudiante  DB_PASSWORD=Developer
#
# Ejemplo Supabase (Project Settings -> Database -> Connect ->
# "Session pooler", que funciona por IPv4 como necesita Render):
#   DB_DRIVER=pgsql  DB_HOST=aws-0-<region>.pooler.supabase.com  DB_PORT=5432
#   DB_DATABASE=postgres  DB_USERNAME=postgres.<id-del-proyecto>
#   DB_PASSWORD=<clave de la base de datos>  DB_SSLMODE=require
# ----------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_CHARSET=utf8mb4
DB_SSLMODE=

# ----------------------------------------------------------------
# Correo electrónico (SMTP)
# Para Gmail: activa la verificación en 2 pasos y genera una
# "Contraseña de aplicación" en Cuenta Google → Seguridad.
# Para pruebas locales puedes usar Mailtrap (sandbox.smtp.mailtrap.io).
# Nota: el plan gratis de Render bloquea los puertos SMTP; si el envío
# falla, la aplicación sigue funcionando y el error queda en el log.
# ----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=email_que_envia@proveedor.com
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM_ADDRESS=email_que_envia@proveedor.com
SMTP_FROM_NAME=Nombre que tendrá el correo que se envíe
